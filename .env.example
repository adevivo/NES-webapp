# Copy to .env and fill in. Never commit .env.

# Discord Developer Portal -> your app -> General Information -> Application ID (not secret)
DISCORD_CLIENT_ID=1568774241820614747

# Discord Developer Portal -> OAuth2 -> Client Secret (SECRET)
DISCORD_CLIENT_SECRET=

# Production only (holly): Cloudflare named-tunnel token
# (Zero Trust -> Networks -> Tunnels -> your tunnel -> install connector -> the token after --token)
# CLOUDFLARE_TUNNEL_TOKEN=
